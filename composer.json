{
    "name": "almosabbirrakib/laravel-debugger",
    "type": "library",
    "description": "A modern, sleek debugging toolbar for Laravel with a fresh UI/UX design built with Vue 3 and TailwindCSS",
    "keywords": [
        "laravel",
        "debugger",
        "debug",
        "toolbar",
        "vue",
        "tailwindcss",
        "laravel-package",
        "debugging-tool",
        "performance-monitoring"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Almosabbir Rakib",
            "email": "your-email@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "AlmosabbirRakib\\LaravelDebugger\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlmosabbirRakib\\LaravelDebugger\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AlmosabbirRakib\\LaravelDebugger\\LaravelDebuggerServiceProvider"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}